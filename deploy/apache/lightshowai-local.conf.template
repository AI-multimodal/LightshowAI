<VirtualHost *:443>
    ServerName localhost

    SSLEngine on
    SSLCertificateFile {{SSL_DIR}}/cert.pem
    SSLCertificateKeyFile {{SSL_DIR}}/key.pem

    ProxyPreserveHost On

    ProxyPass        /omnixas/ http://127.0.0.1:8443/omnixas/
    ProxyPassReverse /omnixas/ http://127.0.0.1:8443/omnixas/

    ProxyPass        /visitor-count http://127.0.0.1:8443/visitor-count
    ProxyPassReverse /visitor-count http://127.0.0.1:8443/visitor-count

    # Auth routes served by the Dash/Flask server
    ProxyPass        /login         http://127.0.0.1:8443/login
    ProxyPassReverse /login         http://127.0.0.1:8443/login

    ProxyPass        /logout        http://127.0.0.1:8443/logout
    ProxyPassReverse /logout        http://127.0.0.1:8443/logout

    ProxyPass        /auth/         http://127.0.0.1:8443/auth/
    ProxyPassReverse /auth/         http://127.0.0.1:8443/auth/

    ProxyPass        /whoami        http://127.0.0.1:8443/whoami
    ProxyPassReverse /whoami        http://127.0.0.1:8443/whoami

    RequestHeader set X-Forwarded-Proto "https"

    Header always set X-Frame-Options "SAMEORIGIN"

    DocumentRoot {{PROJECT_ROOT}}/html
    DirectoryIndex index.html
    <Directory {{PROJECT_ROOT}}/html>
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog  {{LOG_DIR}}/apache2/error.log
    CustomLog {{LOG_DIR}}/apache2/access.log combined
</VirtualHost>